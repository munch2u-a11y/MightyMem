# MightyMem Credentials Configuration Template
# Copy this file to ~/.mightymem/.env (recommended hidden location outside repo) or .env in project root

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=MTIzNDU2Nzg5.TEST.DISCORD_TOKEN

# Discord Channel ID (for bot message polling & routing)
DISCORD_CHANNEL_ID=1234567890123456789

# Piper Voice Model Path (local ONNX model file path)
PIPER_MODEL_PATH=en_US-lessac-medium.onnx
